DATABASE_URL="postgresql://opentales:opentales@127.0.0.1:5432/opentales?schema=public"
JWT_SECRET="replace-me-with-a-long-random-secret"
PORT="4000"
CORS_ORIGIN="http://localhost:5173"
ASSETS_DIR="./data/assets"
# Comma-separated browser origins allowed to call /mcp. Native MCP clients do not send Origin.
MCP_ALLOWED_ORIGINS="http://localhost:5173,https://tale.yasui.io,https://opentales.hoodgail.me"
MCP_PUBLIC_URL="http://localhost:5173/mcp"
MCP_OAUTH_ISSUER="http://localhost:5173"
# Optional maximum JSON characters returned by one MCP tool before a bounded preview is used.
MCP_MAX_TOOL_RESPONSE_CHARS="100000"
# Optional: used when a project's AI provider is set to Vercel AI Gateway.
AI_GATEWAY_API_KEY=""
# Optional: disable the durable Novel Build polling worker while retaining the API.
AI_NOVEL_BUILD_WORKER_ENABLED="true"
# Optional sourced/versioned override. models.dev pricing is fetched automatically.
# Values are currency micro-units per million tokens.
AI_MODEL_PRICING_JSON="{}"
# Optional in-memory models.dev cache controls (defaults shown).
AI_MODEL_PRICING_CACHE_TTL_MS="21600000"
AI_MODEL_PRICING_CACHE_RETRY_MS="300000"
AI_MODEL_PRICING_FETCH_TIMEOUT_MS="15000"
# AI_MODELS_DEV_PRICING_URL="https://models.dev/api.json"
# Optional task-tier routing. Each configured value is an ordered non-empty array of model IDs.
# AI_MODEL_ROUTING_JSON='{"strong":["provider/reasoning"],"fast":["provider/fast"],"judge":["provider/judge"]}'
