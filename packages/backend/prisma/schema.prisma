  branch              WritingBranch             @relation("BranchVersions", fields: [branchId], references: [id], onDelete: Cascade)
  sourceTask          BuildTask?                @relation("WritingVersionSourceTask", fields: [sourceTaskId], references: [id], onDelete: SetNull)
