  key                String
  version            Int              @default(1)
  isCurrent          Boolean          @default(true)
  title              String
  kind               PlotThreadKind
  status             PlotThreadStatus @default(PLANNED)
  summary            String
  stakes             String?
  sceneIds           String[]         @default([])
  introducedSceneId  String?
  resolvedSceneId    String?
  metadata           Json?
  invalidatedAt      DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildRun         BuildRun             @relation(fields: [buildRunId], references: [id], onDelete: Cascade)
  sourceArtifact   StoryArtifact?       @relation(fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  sourceTask       BuildTask?           @relation("PlotThreadSourceTask", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  sourceUnit       BuildManuscriptUnit? @relation("PlotThreadSourceUnit", fields: [sourceUnitId], references: [id], onDelete: SetNull)
  supersedesThread PlotThread?          @relation("PlotThreadHistory", fields: [supersedesThreadId], references: [id], onDelete: SetNull)
  supersededBy     PlotThread[]         @relation("PlotThreadHistory")
  parentThread     PlotThread?          @relation("PlotThreadHierarchy", fields: [parentThreadId], references: [id], onDelete: SetNull)
  childThreads     PlotThread[]         @relation("PlotThreadHierarchy")
  setupPayoffs     SetupPayoffLink[]

  @@unique([buildRunId, key, version])
  @@index([projectId, kind, status])
  @@index([buildRunId, parentThreadId])
}

model BuildCheckpoint {
  id             String   @id @default(cuid())
  projectId      String
  buildRunId     String
  taskId         String?
  idempotencyKey String
  requestHash    String   @default("")
  createdById    String?
  sequence       Int
  label          String
  phase          String
  stateSnapshot  Json
  contentHash    String
  createdAt      DateTime @default(now())

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildRun     BuildRun           @relation(fields: [buildRunId], references: [id], onDelete: Cascade)
  task         BuildTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("BuildCheckpointCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  directives   BuildDirective[]
  compilations BuildCompilation[]
  reviews      BuildReview[]

  @@unique([buildRunId, sequence])
  @@unique([buildRunId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([taskId])
}

model BuildTrace {
  id                   String           @id @default(cuid())
  projectId            String
  buildRunId           String
  taskId               String?
  idempotencyKey       String
  requestHash          String           @default("")
  finishRequestHash    String?
  attempt              Int
  status               BuildTraceStatus
  provider             String?
  model                String?
  modelParameters      Json?
  workflowVersion      String
  systemPromptVersion  String?
  skillVersions        Json
  toolSchemaVersions   Json
  inputs               Json
  retrievedArtifactIds String[]         @default([])
  contextTokenCount    Int?
  toolCalls            Json
  toolResults          Json
  outputs              Json
  validatorResults     Json
  inputTokens          Int?
  outputTokens         Int?
  costMicros           Int?
  latencyMs            Int?
  retries              Int              @default(0)
  completionState      String?
  error                String?
  startedAt            DateTime         @default(now())
  completedAt          DateTime?

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildRun BuildRun   @relation(fields: [buildRunId], references: [id], onDelete: Cascade)
  task     BuildTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([buildRunId, idempotencyKey])
  @@index([projectId, startedAt])
  @@index([buildRunId, taskId, attempt])
}

model BuildEvaluationResult {
  id             String              @id @default(cuid())
  projectId      String
  buildRunId     String
  taskId         String?
  artifactId     String?
  idempotencyKey String
  requestHash    String              @default("")
  kind           BuildEvaluationKind
  rubric         String
  rubricVersion  String
  scores         Json
  checks         Json
  passed         Boolean
  threshold      Float?
  feedback       String?
  evidence       Json?
  createdAt      DateTime            @default(now())

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildRun BuildRun       @relation(fields: [buildRunId], references: [id], onDelete: Cascade)
  task     BuildTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  artifact StoryArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@unique([buildRunId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([buildRunId, taskId])
  @@index([artifactId])
}

model BuildOperationReceipt {
  id             String   @id @default(cuid())
  buildRunId     String
  operation      String
  idempotencyKey String
  requestHash    String
  response       Json
  createdAt      DateTime @default(now())

  buildRun BuildRun @relation(fields: [buildRunId], references: [id], onDelete: Cascade)

  @@unique([buildRunId, idempotencyKey])
  @@index([buildRunId, operation, createdAt])
}

model BuildDirective {
  id                String   @id @default(cuid())
  projectId         String
  buildRunId        String
  fromTaskId        String
  checkpointId      String?
  createdById       String?
  idempotencyKey    String
  directive         String
  pinnedArtifactIds String[] @default([])
  createdAt         DateTime @default(now())

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildRun   BuildRun         @relation(fields: [buildRunId], references: [id], onDelete: Cascade)
  fromTask   BuildTask        @relation(fields: [fromTaskId], references: [id], onDelete: Cascade)
  checkpoint BuildCheckpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  createdBy  User?            @relation("BuildDirectiveCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([buildRunId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([buildRunId, createdAt])
  @@index([fromTaskId])
  @@index([checkpointId])
}

model BuildManuscriptUnit {
  id              String                    @id @default(cuid())
  projectId       String
  buildRunId      String
  sourceTaskId    String?
  planArtifactId  String?
  parentUnitId    String?
  sourceChapterId String?
  sourceSceneId   String?
  writingId       String                    @unique
  branchId        String                    @unique
  kind            BuildManuscriptUnitKind
  status          BuildManuscriptUnitStatus @default(PLANNED)
  key             String
  containerKey    String
  order           Int
  chapterNumber   Int?
  title           String
  povCharacterId  String?
  locationId      String?
  storyDate       String?
  storyTime       String?
  tension         Float?
  metadata        Json
  revision        Int                       @default(0)
  invalidatedAt   DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildRun         BuildRun               @relation(fields: [buildRunId], references: [id], onDelete: Cascade)
  sourceTask       BuildTask?             @relation("BuildUnitSourceTask", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  planArtifact     StoryArtifact?         @relation("BuildUnitPlanArtifact", fields: [planArtifactId], references: [id], onDelete: SetNull)
  parentUnit       BuildManuscriptUnit?   @relation("BuildUnitTree", fields: [parentUnitId], references: [id], onDelete: Cascade)
  childUnits       BuildManuscriptUnit[]  @relation("BuildUnitTree")
  sourceChapter    Chapter?               @relation("BuildUnitSourceChapter", fields: [sourceChapterId], references: [id], onDelete: SetNull)
  sourceScene      Scene?                 @relation("BuildUnitSourceScene", fields: [sourceSceneId], references: [id], onDelete: SetNull)
  writing          Writing                @relation("BuildUnitWriting", fields: [writingId], references: [id], onDelete: Cascade)
  branch           WritingBranch          @relation("BuildUnitBranch", fields: [branchId], references: [id], onDelete: Cascade)
  povCharacter     Character?             @relation("BuildUnitPovCharacter", fields: [povCharacterId], references: [id], onDelete: SetNull)
  location         Location?              @relation("BuildUnitLocation", fields: [locationId], references: [id], onDelete: SetNull)
  bindings         StoryArtifactBinding[]
  compilationUnits BuildCompilationUnit[]
  reviewUnits      BuildReviewUnit[]
  canonFacts       CanonFact[]            @relation("CanonFactSourceUnit")
  entityStates     EntityState[]          @relation("EntityStateSourceUnit")
  timelineEvents   TimelineEvent[]        @relation("TimelineEventSourceUnit")
  openLoops        OpenLoop[]             @relation("OpenLoopSourceUnit")
  setupPayoffs     SetupPayoffLink[]      @relation("SetupPayoffSourceUnit")
  plotThreads      PlotThread[]           @relation("PlotThreadSourceUnit")

  @@unique([buildRunId, kind, key])
  @@unique([buildRunId, kind, containerKey, order])
  @@index([projectId, kind, order])
  @@index([buildRunId, parentUnitId, order])
  @@index([sourceTaskId])
  @@index([planArtifactId])
}

model StoryArtifactBinding {
  id          String                   @id @default(cuid())
  projectId   String
  buildRunId  String
  artifactId  String
  taskId      String?
  unitId      String?
  bindingKind StoryArtifactBindingKind
  entityType  String?
  entityId    String?
  role        String
  createdAt   DateTime                 @default(now())

  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildRun BuildRun             @relation(fields: [buildRunId], references: [id], onDelete: Cascade)
  artifact StoryArtifact        @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  task     BuildTask?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  unit     BuildManuscriptUnit? @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([artifactId, bindingKind, role, unitId, entityType, entityId])
  @@index([projectId, entityType, entityId])
  @@index([buildRunId, bindingKind])
  @@index([unitId])
  @@index([taskId])
}

model BuildCompilation {
  id                       String   @id @default(cuid())
  projectId                String
  buildRunId               String
  checkpointId             String?
  exportManifestArtifactId String?
  idempotencyKey           String
  requestHash              String
  manifest                 Json
  totalWordCount           Int
  contentHash              String
  createdAt                DateTime @default(now())

  project                Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildRun               BuildRun               @relation(fields: [buildRunId], references: [id], onDelete: Cascade)
  checkpoint             BuildCheckpoint?       @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  exportManifestArtifact StoryArtifact?         @relation("CompilationExportManifest", fields: [exportManifestArtifactId], references: [id], onDelete: SetNull)
  units                  BuildCompilationUnit[]
  reviews                BuildReview[]
  exports                ProjectExport[]

  @@unique([buildRunId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([buildRunId, createdAt])
}

model BuildCompilationUnit {
  id               String @id @default(cuid())
  compilationId    String
  unitId           String
  writingVersionId String
  order            Int
  wordCount        Int
  contentHash      String

  compilation    BuildCompilation    @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  unit           BuildManuscriptUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  writingVersion WritingVersion      @relation("CompilationWritingVersion", fields: [writingVersionId], references: [id], onDelete: Restrict)

  @@unique([compilationId, unitId])
  @@index([unitId])
  @@index([writingVersionId])
}

model BuildReview {
  id              String            @id @default(cuid())
  projectId       String
  buildRunId      String
  compilationId   String
  checkpointId    String?
  createdById     String?
  approvedById    String?
  mergedById      String?
  title           String
  message         String?
  status          BuildReviewStatus @default(OPEN)
  revision        Int               @default(0)
  approvedAt      DateTime?
  mergedAt        DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildRun    BuildRun          @relation(fields: [buildRunId], references: [id], onDelete: Cascade)
  compilation BuildCompilation  @relation(fields: [compilationId], references: [id], onDelete: Restrict)
  checkpoint  BuildCheckpoint?  @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("BuildReviewCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy  User?             @relation("BuildReviewApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  mergedBy    User?             @relation("BuildReviewMergedBy", fields: [mergedById], references: [id], onDelete: SetNull)
  units       BuildReviewUnit[]

  @@index([projectId, status, createdAt])
  @@index([buildRunId, status])
}

model BuildReviewUnit {
  id                        String                @id @default(cuid())
  reviewId                  String
  unitId                    String
  action                    BuildReviewUnitAction
  targetChapterId           String?
  targetSceneId             String?
  expectedMainHeadVersionId String?
  sourceBuildVersionId      String
  reviewedUnitRevision      Int                   @default(0)
  reviewedUnitSnapshot      Json                  @default("{}")
  reviewedUnitSnapshotHash  String                @default("")
  reviewedContentHash       String                @default("")
  resultMainVersionId       String?
  order                     Int

  review                  BuildReview         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  unit                    BuildManuscriptUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  targetChapter           Chapter?            @relation(fields: [targetChapterId], references: [id], onDelete: SetNull)
  targetScene             Scene?              @relation(fields: [targetSceneId], references: [id], onDelete: SetNull)
  expectedMainHeadVersion WritingVersion?     @relation("ReviewExpectedMainVersion", fields: [expectedMainHeadVersionId], references: [id], onDelete: SetNull)
  sourceBuildVersion      WritingVersion      @relation("ReviewSourceBuildVersion", fields: [sourceBuildVersionId], references: [id], onDelete: Restrict)
  resultMainVersion       WritingVersion?     @relation("ReviewResultMainVersion", fields: [resultMainVersionId], references: [id], onDelete: SetNull)

  @@unique([reviewId, unitId])
  @@index([targetChapterId])
  @@index([targetSceneId])
}

model ProjectExport {
  id                String              @id @default(cuid())
  projectId         String
  buildRunId        String?
  compilationId     String?
  assetId           String?             @unique
  requestedById     String?
  regeneratedFromId String?
  idempotencyKey    String
  requestHash       String
  target            ProjectExportTarget
  format            ProjectExportFormat
  preset            ProjectExportPreset
  status            ProjectExportStatus @default(PENDING)
  filename          String
  mimeType          String?
  checksum          String?
  sizeBytes         BigInt?
  options           Json
  provenance        Json
  branchHeads       Json
  error             String?
  generatedAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildRun        BuildRun?         @relation(fields: [buildRunId], references: [id], onDelete: Cascade)
  compilation     BuildCompilation? @relation(fields: [compilationId], references: [id], onDelete: SetNull)
  asset           Asset?            @relation("ProjectExportAsset", fields: [assetId], references: [id], onDelete: SetNull)
  requestedBy     User?             @relation("ProjectExportRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  regeneratedFrom ProjectExport?    @relation("ProjectExportRegeneration", fields: [regeneratedFromId], references: [id], onDelete: SetNull)
  regenerations   ProjectExport[]   @relation("ProjectExportRegeneration")

  @@unique([projectId, idempotencyKey])
  @@index([projectId, status, createdAt])
  @@index([buildRunId, compilationId])
  @@index([requestedById])
  @@index([regeneratedFromId])
}

model ProjectImport {
  id                  String              @id @default(cuid())
  projectId           String
  assetId             String?             @unique
  createdById         String?
  idempotencyKey      String
  applyIdempotencyKey String?
  requestHash         String
  format              ProjectImportFormat
  status              ProjectImportStatus @default(PREVIEWED)
  filename            String
  mimeType            String
  checksum            String
  sizeBytes           BigInt
  preview             Json
  conflicts           Json
  sourceMetadata      Json
  applyResult         Json?
  error               String?
  expiresAt           DateTime
  appliedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset     Asset?  @relation("ProjectImportAsset", fields: [assetId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("ProjectImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, idempotencyKey])
  @@index([projectId, status, createdAt])
  @@index([createdById])
  @@index([expiresAt])
}

model NamedSnapshot {
  id              String             @id @default(cuid())
  projectId       String
  createdById     String?
  idempotencyKey  String
  requestHash     String
  label           String
  message         String?
  scope           NamedSnapshotScope
  chapterId       String?
  sceneId         String?
  projectDocId    String?
  writingId       String?
  buildRunId      String?
  checkpointId    String?
  compilationId   String?
  heads           Json
  structuredState Json
  contentHash     String
  sizeBytes       Int
  createdAt       DateTime           @default(now())
  deletedAt       DateTime?

  project    Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?                      @relation("NamedSnapshotCreator", fields: [createdById], references: [id], onDelete: SetNull)
  operations SnapshotOperationReceipt[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, scope, createdAt])
  @@index([buildRunId, checkpointId])
  @@index([chapterId])
  @@index([sceneId])
  @@index([writingId])
}

model WritingAnnotationThread {
  id                     String                  @id @default(cuid())
  projectId              String
  writingId              String
  branchId               String
  anchorVersionId        String
  authorId               String?
  resolvedById           String?
  acceptedVersionId      String?
  chapterId              String?
  sceneId                String?
  idempotencyKey         String
  requestHash            String
  kind                   WritingAnnotationKind
  status                 WritingAnnotationStatus @default(OPEN)
  revision               Int                     @default(0)
  startOffset            Int
  endOffset              Int
  quote                  String
  anchorHash             String
  body                   String
  suggestedReplacement   String?
  decisionIdempotencyKey String?
  decisionRequestHash    String?
  resolvedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  project         Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  writing         Writing                  @relation(fields: [writingId], references: [id], onDelete: Cascade)
  branch          WritingBranch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  anchorVersion   WritingVersion           @relation("AnnotationAnchorVersion", fields: [anchorVersionId], references: [id], onDelete: Cascade)
  acceptedVersion WritingVersion?          @relation("AnnotationAcceptedVersion", fields: [acceptedVersionId], references: [id], onDelete: SetNull)
  author          User?                    @relation("WritingAnnotationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  resolvedBy      User?                    @relation("WritingAnnotationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  replies         WritingAnnotationReply[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, status, updatedAt])
  @@index([writingId, status, startOffset])
  @@index([chapterId, status])
  @@index([sceneId, status])
  @@index([branchId, anchorVersionId])
}

model WritingAnnotationReply {
  id             String   @id @default(cuid())
  threadId       String
  authorId       String?
  idempotencyKey String
  requestHash    String
  body           String
  createdAt      DateTime @default(now())

  thread WritingAnnotationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User?                   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([threadId, idempotencyKey])
  @@index([threadId, createdAt])
}

model RenameRefactorReceipt {
  id             String   @id @default(cuid())
  projectId      String
  idempotencyKey String
  requestHash    String
  targetType     String
  targetId       String
  result         Json
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, idempotencyKey])
  @@index([projectId, targetType, targetId])
}

model SnapshotOperationReceipt {
  id             String   @id @default(cuid())
  snapshotId     String
  idempotencyKey String
  requestHash    String
  operation      String
  result         Json
  createdAt      DateTime @default(now())

  snapshot NamedSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, idempotencyKey])
}
