  reviewExpectedUnits BuildReviewUnit[]         @relation("ReviewExpectedMainVersion")
  reviewSourceUnits   BuildReviewUnit[]         @relation("ReviewSourceBuildVersion")
  reviewResultUnits   BuildReviewUnit[]         @relation("ReviewResultMainVersion")
  anchoredAnnotations WritingAnnotationThread[] @relation("AnnotationAnchorVersion")
  acceptedAnnotations WritingAnnotationThread[] @relation("AnnotationAcceptedVersion")

  @@index([branchId])
  @@index([sourceTaskId])
  @@index([parentVersionId])
}

model Asset {
  id           String    @id @default(cuid())
