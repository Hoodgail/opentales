generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum CoverOrientation {
  LANDSCAPE
  PORTRAIT
}

enum ProjectVisibility {
  PRIVATE
  PUBLIC
}

enum ChapterStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  FINAL
}

enum SceneStatus {
  PLANNED
  DRAFT
  IN_PROGRESS
  REVIEW
  REVISED
  FINAL
}

enum ObstacleType {
  INTERNAL
  EXTERNAL
  INTERPERSONAL
}

enum WritingKind {
  CHAPTER_BODY
  SCENE_BODY
  LOGLINE
  OUTLINE
  CLIMAX
  CHARACTER_DESCRIPTION
  CHARACTER_APPEARANCE
  CHARACTER_MOTIVATION
  CHARACTER_ARC
  LOCATION_DESCRIPTION
  LOCATION_ATMOSPHERE
  LOCATION_SIGNIFICANCE
  LOCATION_SENSORY
  OBSTACLE_DESCRIPTION
  OBSTACLE_RESOLUTION
  NOTE
}

enum AssetKind {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEXT_BLOB
}

enum ProjectExportFormat {
  DOCX
  PDF
  EPUB
  MARKDOWN
  TEXT
  HTML
  PROJECT_ARCHIVE
}

enum ProjectExportPreset {
  STANDARD_MANUSCRIPT
  READING_COPY
  EBOOK
  WEB
  ARCHIVE
}

enum ProjectExportTarget {
  MAIN
  BUILD
}

enum ProjectExportStatus {
  PENDING
  GENERATING
  READY
  FAILED
  DELETED
}

enum ProjectImportFormat {
  DOCX
  MARKDOWN
  TEXT
  HTML
  PROJECT_ARCHIVE
}

enum ProjectImportStatus {
  PREVIEWED
  APPLYING
  APPLIED
  FAILED
}

enum NamedSnapshotScope {
  PROJECT
  CHAPTER
  SCENE
  PROJECT_DOC
  WRITING
  BUILD_CHECKPOINT
  BUILD_COMPILATION
}

enum WritingAnnotationKind {
  COMMENT
  NOTE
  SUGGESTION
}

enum WritingAnnotationStatus {
  OPEN
  RESOLVED
  ACCEPTED
  REJECTED
}

enum AttachmentEntity {
  CHARACTER
  LOCATION
  CHAPTER
  SCENE
  PROJECT
  WRITING_VERSION
  USER
}

enum TabKind {
  CHAPTER
  SCENE
  CHARACTER
  LOCATION
  STRUCTURE
  OUTLINE
}

enum SubmissionKind {
  CHAPTER_EDIT
  NEW_CHAPTER
}

enum SubmissionStatus {
  OPEN
  MERGED
  DECLINED
}

enum ActivityType {
  SUBMISSION_OPENED
  SUBMISSION_MERGED
  SUBMISSION_DECLINED
  COMMENT_ADDED
  AI_REVIEW_POSTED
}

enum AiProviderKind {
  GATEWAY
  OPENAI_COMPATIBLE
  GITHUB_COPILOT
}

enum ProjectDocKind {
  NOTE
  BRAINSTORM
  INSTRUCTIONS
  REFERENCE
  OTHER
}

enum AiAgentSessionStatus {
  IDLE
  RUNNING
  CANCELLED
  ERROR
}

enum AiAgentApprovalMode {
  MANUAL
  AUTO
}

enum AiAgentMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AiAgentPromptStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  ERROR
}

enum AiToolCallStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RUNNING
  EXECUTED
  ERROR
}

enum BuildAutonomyMode {
  ASSIST
  PLAN_REVIEW
  AUTONOMOUS_DRAFT
}

enum BuildRunStatus {
  PLANNING
  DRAFTING
  REVISING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum BuildTaskStatus {
  BLOCKED
  READY
  RUNNING
  REVIEW
  DONE
  FAILED
  CANCELLED
}

enum StoryArtifactType {
  STORY_BRIEF
  NARRATIVE_CONTRACT
  CHARACTER_BIBLE
  RELATIONSHIP_GRAPH
  WORLD_BIBLE
  PLOT_THREAD
  ACT_ARCHITECTURE
  CHAPTER_BRIEF
  SCENE_PLAN
  TIMELINE
  SETUP_PAYOFF_MAP
  RESEARCH_QUESTIONS
  OPEN_QUESTIONS
  BEAT
  CHAPTER_DRAFT
  REVISION_ISSUE
  FINALE_PLAN
  EXPORT_MANIFEST
}

enum BuildManuscriptUnitKind {
  CHAPTER
  SCENE
}

enum BuildManuscriptUnitStatus {
  PLANNED
  DRAFTING
  REVIEW
  ACCEPTED
  INVALIDATED
}

enum StoryArtifactBindingKind {
  BUILD_UNIT
  ENTITY
  LEDGER
}

enum BuildReviewStatus {
  OPEN
  APPROVED
  MERGED
  REJECTED
}

enum BuildReviewUnitAction {
  CREATE
  UPDATE
}

enum StoryArtifactStatus {
  DRAFT
  VALIDATED
  ACCEPTED
  SUPERSEDED
  INVALIDATED
}

enum CanonFactStatus {
  PROPOSED
  CANONICAL
  DISPUTED
  RETRACTED
  INVALIDATED
}

enum EntityStateStatus {
  PROPOSED
  ACTIVE
  SUPERSEDED
  INVALIDATED
}

enum OpenLoopKind {
  PROMISE
  QUESTION
  CLUE
  SETUP
  MYSTERY
  FORESHADOWING
  OTHER
}

enum OpenLoopStatus {
  OPEN
  REINFORCED
  RESOLVED
  ABANDONED
  INVALIDATED
}

enum SetupPayoffStatus {
  PLANNED
  SETUP
  REINFORCED
  PAID_OFF
  ABANDONED
  INVALIDATED
}

enum PlotThreadKind {
  MAIN
  SUBPLOT
  CHARACTER_ARC
  MYSTERY
  ROMANCE
  THEMATIC
  OTHER
}

enum PlotThreadStatus {
  PLANNED
  ACTIVE
  RESOLVED
  ABANDONED
  INVALIDATED
}

enum BuildTraceStatus {
  STARTED
  COMPLETED
  FAILED
}

enum BuildEvaluationKind {
  DETERMINISTIC
  MODEL
  HUMAN
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String
  name          String?
  avatarAssetId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  avatarAsset           Asset?                    @relation("UserAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  memberships           Membership[]
  writingVersions       WritingVersion[]
  uploadedAssets        Asset[]                   @relation("UploadedAssets")
  projectStates         UserProjectState[]
  sentInvites           Invite[]                  @relation("InviteInviter")
  acceptedInvites       Invite[]                  @relation("InviteAcceptedBy")
  submissions           Submission[]              @relation("SubmissionAuthor")
  decidedSubmissions    Submission[]              @relation("SubmissionDecidedBy")
  activities            Activity[]
  betaShareLinks        BetaShareLink[]           @relation("BetaShareCreatedBy")
  createdBuildRuns      BuildRun[]                @relation("BuildRunCreatedBy")
  authorizedBuildRuns   BuildRun[]                @relation("BuildRunAuthorizedBy")
  buildCheckpoints      BuildCheckpoint[]         @relation("BuildCheckpointCreatedBy")
  buildDirectives       BuildDirective[]          @relation("BuildDirectiveCreatedBy")
  createdBuildReviews   BuildReview[]             @relation("BuildReviewCreatedBy")
  approvedBuildReviews  BuildReview[]             @relation("BuildReviewApprovedBy")
  mergedBuildReviews    BuildReview[]             @relation("BuildReviewMergedBy")
  requestedExports      ProjectExport[]           @relation("ProjectExportRequestedBy")
  createdNamedSnapshots NamedSnapshot[]           @relation("NamedSnapshotCreator")
  authoredAnnotations   WritingAnnotationThread[] @relation("WritingAnnotationAuthor")
  resolvedAnnotations   WritingAnnotationThread[] @relation("WritingAnnotationResolver")
  annotationReplies     WritingAnnotationReply[]
  createdImports        ProjectImport[]           @relation("ProjectImportCreatedBy")
}

model Org {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  projects    Project[]
  invites     Invite[]
}

model Invite {
  id           String    @id @default(cuid())
  orgId        String
  invitedById  String
  email        String?
  username     String?
  role         Role
  token        String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?

  org        Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy  User  @relation("InviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([acceptedById])
}

model Membership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      Role
  createdAt DateTime @default(now())

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Project {
  id               String            @id @default(cuid())
  orgId            String
  slug             String
  title            String
  description      String?
  genre            String?
  perspective      String?
  pov              String?
  voice            String?
  tone             String?
  themes           String[]          @default([])
  coverAssetId     String?
  coverOrientation CoverOrientation  @default(LANDSCAPE)
  visibility       ProjectVisibility @default(PRIVATE)
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  archivedAt       DateTime?
  deletedAt        DateTime?

  org                    Org                       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  coverAsset             Asset?                    @relation("ProjectCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  storyStructure         StoryStructure?
  characters             Character[]
  characterRelationships CharacterRelationship[]
  locations              Location[]
  acts                   Act[]
  chapters               Chapter[]
  writings               Writing[]
  assets                 Asset[]
  obstacles              Obstacle[]
  projectStates          UserProjectState[]
  submissions            Submission[]
  betaShareLinks         BetaShareLink[]
  aiSettings             ProjectAiSettings?
  docs                   ProjectDoc[]
  folders                ProjectFolder[]
  aiAgentSessions        ProjectAiAgentSession[]
  aiSkills               ProjectAiSkill[]
  buildRuns              BuildRun[]
  storyArtifacts         StoryArtifact[]
  storyArtifactLinks     StoryArtifactLink[]
  canonFacts             CanonFact[]
  entityStates           EntityState[]
  timelineEvents         TimelineEvent[]
  openLoops              OpenLoop[]
  setupPayoffLinks       SetupPayoffLink[]
  plotThreads            PlotThread[]
  buildCheckpoints       BuildCheckpoint[]
  buildTraces            BuildTrace[]
  buildEvaluationResults BuildEvaluationResult[]
  buildDirectives        BuildDirective[]
  buildManuscriptUnits   BuildManuscriptUnit[]
  storyArtifactBindings  StoryArtifactBinding[]
  buildCompilations      BuildCompilation[]
  buildReviews           BuildReview[]
  exports                ProjectExport[]
  namedSnapshots         NamedSnapshot[]
  writingAnnotations     WritingAnnotationThread[]
  imports                ProjectImport[]
  renameRefactorReceipts RenameRefactorReceipt[]

  @@unique([orgId, slug])
  @@index([orgId])
}

model ProjectAiAgentSession {
  id               String               @id @default(cuid())
  projectId        String
  activeBuildRunId String?
  title            String?
  approvalMode     AiAgentApprovalMode  @default(MANUAL)
  status           AiAgentSessionStatus @default(IDLE)
  activePromptId   String?
  nextPartSequence Int                  @default(0)
  lastError        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activeBuildRun BuildRun?            @relation(fields: [activeBuildRunId], references: [id], onDelete: SetNull)
  messages       AiAgentMessage[]
  prompts        AiAgentPrompt[]
  toolCalls      AiAgentToolCall[]
  parts          AiAgentSessionPart[]

  @@index([projectId, updatedAt])
  @@index([activeBuildRunId])
}

model AiAgentSessionPart {
  id         String   @id @default(cuid())
  sessionId  String
  promptId   String?
  messageId  String?
  toolCallId String?
  kind       String
  sequence   Int
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session  ProjectAiAgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  prompt   AiAgentPrompt?        @relation(fields: [promptId], references: [id], onDelete: SetNull)
  message  AiAgentMessage?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  toolCall AiAgentToolCall?      @relation(fields: [toolCallId], references: [id], onDelete: SetNull)

  @@unique([sessionId, sequence])
  @@unique([sessionId, kind, toolCallId])
  @@index([sessionId, createdAt])
  @@index([messageId])
  @@index([toolCallId])
}

model AiAgentMessage {
  id        String             @id @default(cuid())
  sessionId String
  role      AiAgentMessageRole
  content   String
  createdAt DateTime           @default(now())

  session ProjectAiAgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parts   AiAgentSessionPart[]

  @@index([sessionId, createdAt])
}

model AiAgentPrompt {
  id        String              @id @default(cuid())
  sessionId String
  prompt    String
  status    AiAgentPromptStatus @default(QUEUED)
  order     Int
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  session ProjectAiAgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parts   AiAgentSessionPart[]

  @@index([sessionId, status, order])
}

model AiAgentToolCall {
  id          String           @id @default(cuid())
  sessionId   String
  promptId    String?
  toolCallId  String?
  toolName    String
  input       Json
  status      AiToolCallStatus @default(PENDING_APPROVAL)
  output      Json?
  error       String?
  createdAt   DateTime         @default(now())
  decidedAt   DateTime?
  decidedById String?

  session ProjectAiAgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parts   AiAgentSessionPart[]

  @@unique([sessionId, toolCallId])
  @@index([sessionId, status, createdAt])
  @@index([toolCallId])
}

model ProjectDoc {
  id            String         @id @default(cuid())
  projectId     String
  folderId      String?
  title         String
  kind          ProjectDocKind @default(NOTE)
  bodyWritingId String
  order         Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder      ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  bodyWriting Writing        @relation("ProjectDocBodyWriting", fields: [bodyWritingId], references: [id], onDelete: Restrict)

  @@index([folderId, order])
  @@index([projectId, order])
  @@index([projectId, kind])
}

model ProjectFolder {
  id             String   @id @default(cuid())
  projectId      String
  parentFolderId String?
  name           String
  path           String
  order          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentFolder ProjectFolder?  @relation("ProjectFolderTree", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders ProjectFolder[] @relation("ProjectFolderTree")
  docs         ProjectDoc[]
  assets       Asset[]

  @@unique([projectId, path])
  @@index([projectId, parentFolderId, order])
  @@index([parentFolderId])
}

model ProjectAiSettings {
  id           String         @id @default(cuid())
  projectId    String         @unique
  enabled      Boolean        @default(false)
  providerKind AiProviderKind @default(GATEWAY)
  model        String         @default("openai/gpt-5.4")
  baseUrl      String?
  apiKey       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectAiSkill {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String
  content     String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, enabled])
}

model BetaShareLink {
  id            String    @id @default(cuid())
  projectId     String
  token         String    @unique
  // null = entire manuscript; otherwise restricted to these chapter ids.
  chapterIds    String[]  @default([])
  // Whether unauthenticated visitors may post comments on this share.
  allowComments Boolean   @default(true)
  // Optional human label shown to the owner (e.g. "agent — Sarah").
  label         String?
  createdById   String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User               @relation("BetaShareCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  comments  BetaShareComment[]

  @@index([projectId])
}

model BetaShareComment {
  id          String   @id @default(cuid())
  shareLinkId String
  // Visitor-provided display name (no auth on the public side).
  visitorName String
  body        String
  // Optional anchor to a chapter and line range in that chapter.
  chapterId   String?
  lineStart   Int?
  lineEnd     Int?
  createdAt   DateTime @default(now())

  shareLink BetaShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId, createdAt])
}

model StoryStructure {
  id               String @id @default(cuid())
  projectId        String @unique
  loglineWritingId String
  outlineWritingId String
  climaxWritingId  String

  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  loglineWriting Writing @relation("StoryLoglineWriting", fields: [loglineWritingId], references: [id], onDelete: Restrict)
  outlineWriting Writing @relation("StoryOutlineWriting", fields: [outlineWritingId], references: [id], onDelete: Restrict)
  climaxWriting  Writing @relation("StoryClimaxWriting", fields: [climaxWritingId], references: [id], onDelete: Restrict)
}

model Character {
  id                   String   @id @default(cuid())
  projectId            String
  name                 String
  role                 String?
  age                  String?
  occupation           String?
  traits               String[] @default([])
  aliases              String[] @default([])
  avatarAssetId        String?
  descriptionWritingId String
  appearanceWritingId  String
  motivationWritingId  String
  arcWritingId         String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project               Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  avatarAsset           Asset?                  @relation("CharacterAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  descriptionWriting    Writing                 @relation("CharacterDescriptionWriting", fields: [descriptionWritingId], references: [id], onDelete: Restrict)
  appearanceWriting     Writing                 @relation("CharacterAppearanceWriting", fields: [appearanceWritingId], references: [id], onDelete: Restrict)
  motivationWriting     Writing                 @relation("CharacterMotivationWriting", fields: [motivationWritingId], references: [id], onDelete: Restrict)
  arcWriting            Writing                 @relation("CharacterArcWriting", fields: [arcWritingId], references: [id], onDelete: Restrict)
  outgoingRelationships CharacterRelationship[] @relation("RelationshipFrom")
  incomingRelationships CharacterRelationship[] @relation("RelationshipTo")
  povChapters           Chapter[]               @relation("ChapterPovCharacter")
  povScenes             Scene[]                 @relation("ScenePovCharacter")
  povBuildUnits         BuildManuscriptUnit[]   @relation("BuildUnitPovCharacter")

  @@index([projectId])
  @@index([aliases], type: Gin, map: "Character_aliases_gin_idx")
}

model CharacterRelationship {
  id              String  @id @default(cuid())
  projectId       String
  fromCharacterId String
  toCharacterId   String
  type            String
  note            String?

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromCharacter Character @relation("RelationshipFrom", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacter   Character @relation("RelationshipTo", fields: [toCharacterId], references: [id], onDelete: Cascade)

  @@unique([fromCharacterId, toCharacterId, type])
  @@index([projectId])
  @@index([toCharacterId])
}

model Location {
  id                    String   @id @default(cuid())
  projectId             String
  name                  String
  aliases               String[] @default([])
  type                  String?
  imageAssetId          String?
  descriptionWritingId  String
  atmosphereWritingId   String
  significanceWritingId String
  sensoryWritingId      String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageAsset          Asset?                @relation("LocationImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  descriptionWriting  Writing               @relation("LocationDescriptionWriting", fields: [descriptionWritingId], references: [id], onDelete: Restrict)
  atmosphereWriting   Writing               @relation("LocationAtmosphereWriting", fields: [atmosphereWritingId], references: [id], onDelete: Restrict)
  significanceWriting Writing               @relation("LocationSignificanceWriting", fields: [significanceWritingId], references: [id], onDelete: Restrict)
  sensoryWriting      Writing               @relation("LocationSensoryWriting", fields: [sensoryWritingId], references: [id], onDelete: Restrict)
  chapters            Chapter[]
  scenes              Scene[]
  buildUnits          BuildManuscriptUnit[] @relation("BuildUnitLocation")

  @@index([projectId])
  @@index([aliases], type: Gin, map: "Location_aliases_gin_idx")
}

model Act {
  id        String @id @default(cuid())
  projectId String
  title     String
  order     Int

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@unique([projectId, order])
  @@index([projectId])
}

model Chapter {
  id             String        @id @default(cuid())
  projectId      String
  actId          String?
  number         Int
  title          String
  status         ChapterStatus @default(DRAFT)
  povCharacterId String?
  locationId     String?
  summary        String?
  bodyWritingId  String
  order          Int
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  act              Act?                  @relation(fields: [actId], references: [id], onDelete: SetNull)
  povCharacter     Character?            @relation("ChapterPovCharacter", fields: [povCharacterId], references: [id], onDelete: SetNull)
  location         Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  bodyWriting      Writing               @relation("ChapterBodyWriting", fields: [bodyWritingId], references: [id], onDelete: Restrict)
  scenes           Scene[]
  submissions      Submission[]
  sourceBuildUnits BuildManuscriptUnit[] @relation("BuildUnitSourceChapter")
  buildReviewUnits BuildReviewUnit[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([projectId, deletedAt])
  @@index([actId, order])
}

model Scene {
  id                     String      @id @default(cuid())
  chapterId              String
  order                  Int
  title                  String?
  status                 SceneStatus @default(DRAFT)
  povCharacterId         String?
  locationId             String?
  storyDate              String?
  storyTime              String?
  estimatedWordCount     Int?
  actualWordCount        Int         @default(0)
  sceneFunction          String?
  goal                   String?
  obstacle               String?
  stakes                 String?
  conflict               String?
  turn                   String?
  revelation             String?
  outcome                String?
  emotionalValueShift    String?
  tension                Float?
  characterPresentIds    String[]    @default([])
  characterReferencedIds String[]    @default([])
  plotThreadIds          String[]    @default([])
  setupPayoffIds         String[]    @default([])
  knowledgeDeltas        Json?
  objectTransfers        Json?
  injuryStateChanges     Json?
  worldRuleRefs          Json?
  entryState             Json?
  exitState              Json?
  summary                String?
  writerNotes            String?
  aiNotes                String?
  bodyWritingId          String
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  revision               Int         @default(0)

  chapter          Chapter               @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  povCharacter     Character?            @relation("ScenePovCharacter", fields: [povCharacterId], references: [id], onDelete: SetNull)
  location         Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  bodyWriting      Writing               @relation("SceneBodyWriting", fields: [bodyWritingId], references: [id], onDelete: Restrict)
  sourceBuildUnits BuildManuscriptUnit[] @relation("BuildUnitSourceScene")
  buildReviewUnits BuildReviewUnit[]

  @@unique([chapterId, order])
  @@unique([id, revision])
  @@index([chapterId])
  @@index([characterPresentIds], type: Gin, map: "Scene_characterPresentIds_gin_idx")
  @@index([characterReferencedIds], type: Gin, map: "Scene_characterReferencedIds_gin_idx")
  @@index([plotThreadIds], type: Gin, map: "Scene_plotThreadIds_gin_idx")
  @@index([setupPayoffIds], type: Gin, map: "Scene_setupPayoffIds_gin_idx")
}

model Obstacle {
