{
  "name": "@opentales/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && prisma generate && tsc -p tsconfig.build.json && node scripts/copy-prompt-templates.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval": "vitest run src/evals --reporter=default",
    "eval:model": "tsx src/evals/modelTrials.ts",
    "test:critical-coverage": "vitest run src/useCases/ai src/useCases/novelBuild src/evals/continuityBenchmark.test.ts --coverage --no-file-parallelism",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.98",
    "@ai-sdk/openai-compatible": "^1.0.0",
    "@opentales/sdk": "workspace:*",
    "@prisma/client": "^6.1.0",
    "@types/multer": "^2.1.0",
    "ai": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "handlebars": "^4.7.9",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "sanitize-html": "^2.17.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/sanitize-html": "^2.16.1",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
